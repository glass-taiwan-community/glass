# Copy to .env and fill in. src/index.js loads this via dotenv at startup, which is how
# GUI launches on macOS pick up configuration - they do not inherit the shell environment.

# --- LiteLLM proxy (LLM only) ---
# Use these when personal vendor API keys are disabled and traffic must go through an
# LLM gateway instead. Both values are seeded into Glass's settings on first launch and
# are then editable in the UI; once edited, the stored value wins over these variables.
#
# LITELLM_BASE_URL determines the wire format, mirroring how LiteLLM itself routes:
#   https://llm-proxy.example.com            -> native OpenAI-compatible API (any model
#                                               the proxy exposes: Claude, GPT, Gemini, ...)
#   https://llm-proxy.example.com/anthropic  -> Anthropic passthrough (Claude only)
#
# Use the ROOT url. It was verified to serve /v1/models with `Authorization: Bearer`,
# it is model-agnostic, and it is the route LiteLLM supports best. Do NOT append
# /anthropic unless the root route is unavailable on your deployment.
#
# Model ids on the proxy are namespaced by upstream provider and are discovered
# automatically when the key is saved, e.g.:
#   anthropic/claude-opus-4-8   openai/gpt-5.4   router/gpt-5   gemini/gemini-3.5-flash
#
# Ask your platform team for the gateway URL; do not commit a real internal hostname.
LITELLM_API_KEY=
LITELLM_BASE_URL=https://your-litellm-proxy.example.com

# NOTE: this configures the LLM only. Speech-to-text still uses its own provider
# (OpenAI Realtime / Deepgram / local Whisper) with its own key.
